---
import Badge from '@/components/ui/Badge.astro';
import type { Application } from '@/types';

interface Props {
  app: Application;
}

const { app } = Astro.props;
---

<article class="bg-card-light/60 border-border-subtle shadow-card flex flex-col rounded-2xl border p-6 backdrop-blur-md">
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-primary text-xl font-bold">{app.name}</h3>
    <Badge label={app.category} />
  </div>

  <dl class="text-secondary mt-4 space-y-1 text-sm">
    <div class="flex gap-2">
      <dt class="font-semibold">Estado:</dt>
      <dd>{app.status}</dd>
    </div>
    <div class="flex gap-2">
      <dt class="font-semibold">Plataforma:</dt>
      <dd>{app.target}</dd>
    </div>
  </dl>

  <p class="text-secondary mt-4 leading-relaxed">{app.description}</p>
</article>
